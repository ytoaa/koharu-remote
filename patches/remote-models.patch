+        assert_eq!(output.dimensions(), (900, 900));
+        assert_eq!(output.get_pixel(10, 10), &Rgb([1, 2, 3]));
+        assert_eq!(output.get_pixel(850, 850), &Rgb([1, 2, 3]));
+        assert_eq!(output.get_pixel(500, 500), &Rgb([20, 40, 60]));
+        server.await.unwrap();
+    }
